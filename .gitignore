# Botan build output — generated by make setup
include/
lib/
bin/
doc/

# All compiled output — binaries, debug symbols, profiling data
build/
*.o

# JUnit XML test results (generated by make test / make coverage)
test-results/

# Coverage output (gcov + llvm)
*.gcda
*.gcno
*.profraw
*.profdata
coverage.info
coverage_filtered.info
coverage_report/

# User identity files — never commit these
users/

# TLS certificates — generated by the server on first run
certs/

# SQLite database — generated at runtime; not for version control
zerotrace.db
zerotrace.db-wal
zerotrace.db-shm

# macOS
.DS_Store

# IDE
.vscode/
